// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// © MarketScanner Pros — Multi-Timeframe v1
// Replicates: MSP STATE panel + TIMEFRAME columns
// Shows trend state (TRENDING UP/DOWN, RANGING) across 5 timeframes
// Plus live price ticker and session context

//@version=6
indicator("MSP — State MTF", shorttitle="MSP State", overlay=true, max_labels_count=50)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

grp_tf = "Timeframes"
tf1 = input.timeframe("5",    "TF 1", group=grp_tf)
tf2 = input.timeframe("15",   "TF 2", group=grp_tf)
tf3 = input.timeframe("60",   "TF 3", group=grp_tf)
tf4 = input.timeframe("240",  "TF 4", group=grp_tf)
tf5 = input.timeframe("D",    "TF 5", group=grp_tf)

grp_set = "State Detection"
emaFastLen  = input.int(9,   "Fast EMA",   minval=3,  maxval=21,  group=grp_set)
emaSlowLen  = input.int(21,  "Slow EMA",   minval=10, maxval=55,  group=grp_set)
adxLen      = input.int(14,  "ADX Length",  minval=7,  maxval=30,  group=grp_set)
adxThresh   = input.int(20,  "ADX Trend Threshold", minval=15, maxval=35, group=grp_set)
rsiLen      = input.int(14,  "RSI Length",  minval=7,  maxval=21,  group=grp_set)

grp_thresh = "Thresholds"
rsiOverbought = input.int(60, "RSI Overbought", minval=50, maxval=80, group=grp_thresh)
rsiOversold   = input.int(40, "RSI Oversold",   minval=20, maxval=50, group=grp_thresh)
alignBullThresh = input.int(3, "Bull Alignment Threshold", minval=2, maxval=5, group=grp_thresh)
alignBearThresh = input.int(3, "Bear Alignment Threshold", minval=2, maxval=5, group=grp_thresh)
alignConflictRange = input.int(1, "Conflict Range (abs)", minval=0, maxval=3, group=grp_thresh)

grp_vis = "Display"
showTable    = input.bool(true,  "Show State Table", group=grp_vis)
tablePos     = input.string("bottom_right", "Table Position", options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grp_vis)
showPriceLbl = input.bool(true, "Show Live Price Label", group=grp_vis)
useConfirmedHTF = input.bool(true, "No-repaint mode (confirmed HTF only)", group=grp_vis, tooltip="When ON, higher-timeframe values use the last closed HTF bar (no repainting). When OFF, live HTF values are shown but may repaint until the HTF bar closes.")

// ═══════════════════════════════════════════════════════════════
// MTF STATE DETECTION FUNCTION
// ═══════════════════════════════════════════════════════════════

// Returns: state (1=TRENDING UP, -1=TRENDING DOWN, 0=RANGING)
tfState(emaF, emaS, adxV, c) =>
    isTrending = adxV > adxThresh
    isBull = emaF > emaS and c > emaF
    isBear = emaF < emaS and c < emaF
    state = isTrending and isBull ? 1 : isTrending and isBear ? -1 : 0
    state

// ═══════════════════════════════════════════════════════════════
// FETCH DATA FROM EACH TIMEFRAME (single security call per TF)
// ═══════════════════════════════════════════════════════════════

// Pack everything we need for one TF into a single tuple so each
// timeframe costs exactly one request.security call.
htfPack() =>
    f = ta.ema(close, emaFastLen)
    s = ta.ema(close, emaSlowLen)
    [_dp, _dm, a] = ta.dmi(adxLen, adxLen)
    r = ta.rsi(close, rsiLen)
    c = close
    // Use last confirmed HTF bar to avoid repaint when toggle is on.
    if useConfirmedHTF
        [f[1], s[1], c[1], a[1], r[1]]
    else
        [f, s, c, a, r]

[tf1_emaF, tf1_emaS, tf1_close, tf1_adx, tf1_rsi] = request.security(syminfo.tickerid, tf1, htfPack(), lookahead=barmerge.lookahead_off)
[tf2_emaF, tf2_emaS, tf2_close, tf2_adx, tf2_rsi] = request.security(syminfo.tickerid, tf2, htfPack(), lookahead=barmerge.lookahead_off)
[tf3_emaF, tf3_emaS, tf3_close, tf3_adx, tf3_rsi] = request.security(syminfo.tickerid, tf3, htfPack(), lookahead=barmerge.lookahead_off)
[tf4_emaF, tf4_emaS, tf4_close, tf4_adx, tf4_rsi] = request.security(syminfo.tickerid, tf4, htfPack(), lookahead=barmerge.lookahead_off)
[tf5_emaF, tf5_emaS, tf5_close, tf5_adx, tf5_rsi] = request.security(syminfo.tickerid, tf5, htfPack(), lookahead=barmerge.lookahead_off)

tf1_state = na(tf1_emaF) or na(tf1_adx) ? 0 : tfState(tf1_emaF, tf1_emaS, tf1_adx, tf1_close)
tf2_state = na(tf2_emaF) or na(tf2_adx) ? 0 : tfState(tf2_emaF, tf2_emaS, tf2_adx, tf2_close)
tf3_state = na(tf3_emaF) or na(tf3_adx) ? 0 : tfState(tf3_emaF, tf3_emaS, tf3_adx, tf3_close)
tf4_state = na(tf4_emaF) or na(tf4_adx) ? 0 : tfState(tf4_emaF, tf4_emaS, tf4_adx, tf4_close)
tf5_state = na(tf5_emaF) or na(tf5_adx) ? 0 : tfState(tf5_emaF, tf5_emaS, tf5_adx, tf5_close)

// Data quality flag — any TF still loading?
anyTfMissing = na(tf1_emaF) or na(tf2_emaF) or na(tf3_emaF) or na(tf4_emaF) or na(tf5_emaF)

// ═══════════════════════════════════════════════════════════════
// ALIGNMENT SCORE
// ═══════════════════════════════════════════════════════════════

alignScore = tf1_state + tf2_state + tf3_state + tf4_state + tf5_state
isBullAligned = alignScore >= alignBullThresh
isBearAligned = alignScore <= -alignBearThresh
isConflicted = math.abs(alignScore) <= alignConflictRange

alignLabel = isBullAligned ? "ALIGNED BULL" : isBearAligned ? "ALIGNED BEAR" : isConflicted ? "CONFLICTED" : alignScore > 0 ? "LEAN BULL" : "LEAN BEAR"

// ═══════════════════════════════════════════════════════════════
// HELPER: TF label and state label
// ═══════════════════════════════════════════════════════════════

tfLabel(tf) =>
    tf == "1" ? "1m" : tf == "3" ? "3m" : tf == "5" ? "5m" : tf == "15" ? "15m" : tf == "30" ? "30m" : tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "240" ? "4H" : tf == "D" ? "1D" : tf == "W" ? "1W" : tf == "M" ? "1M" : tf

stateLabel(s) =>
    s > 0 ? "TRENDING UP" : s < 0 ? "TRENDING DN" : "RANGING"

stateClr(s) =>
    s > 0 ? color.new(#10B981, 0) : s < 0 ? color.new(#EF4444, 0) : color.new(#F59E0B, 0)

// ═══════════════════════════════════════════════════════════════
// TABLE DISPLAY
// ═══════════════════════════════════════════════════════════════

tblPos = tablePos == "top_right" ? position.top_right : tablePos == "top_left" ? position.top_left : tablePos == "bottom_right" ? position.bottom_right : position.bottom_left
var tbl = table.new(tblPos, 3, 10, bgcolor=color.new(#0F172A, 5), border_color=color.new(#334155, 30), border_width=1, frame_color=color.new(#10B981, 60), frame_width=1)

if showTable and barstate.islast

    headerBg = color.new(#1E293B, 0)
    green  = color.new(#10B981, 0)
    red    = color.new(#EF4444, 0)
    amber  = color.new(#F59E0B, 0)
    cyan   = color.new(#06B6D4, 0)
    white  = color.new(#E2E8F0, 0)
    dim    = color.new(#94A3B8, 0)
    panelBg = color.new(#0F172A, 10)

    // Header
    table.cell(tbl, 0, 0, "TIMEFRAME", text_color=dim, text_size=size.tiny, bgcolor=headerBg)
    table.cell(tbl, 1, 0, "MSP STATE", text_color=dim, text_size=size.tiny, bgcolor=headerBg)
    table.cell(tbl, 2, 0, "RSI", text_color=dim, text_size=size.tiny, bgcolor=headerBg)

    // TF1
    table.cell(tbl, 0, 1, tfLabel(tf1), text_color=white, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 1, stateLabel(tf1_state), text_color=stateClr(tf1_state), text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 1, str.tostring(math.round(tf1_rsi)), text_color=tf1_rsi > rsiOverbought ? green : tf1_rsi < rsiOversold ? red : dim, text_size=size.tiny, bgcolor=panelBg)

    // TF2
    table.cell(tbl, 0, 2, tfLabel(tf2), text_color=white, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 2, stateLabel(tf2_state), text_color=stateClr(tf2_state), text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 2, str.tostring(math.round(tf2_rsi)), text_color=tf2_rsi > rsiOverbought ? green : tf2_rsi < rsiOversold ? red : dim, text_size=size.tiny, bgcolor=panelBg)

    // TF3
    table.cell(tbl, 0, 3, tfLabel(tf3), text_color=white, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 3, stateLabel(tf3_state), text_color=stateClr(tf3_state), text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 3, str.tostring(math.round(tf3_rsi)), text_color=tf3_rsi > rsiOverbought ? green : tf3_rsi < rsiOversold ? red : dim, text_size=size.tiny, bgcolor=panelBg)

    // TF4
    table.cell(tbl, 0, 4, tfLabel(tf4), text_color=white, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 4, stateLabel(tf4_state), text_color=stateClr(tf4_state), text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 4, str.tostring(math.round(tf4_rsi)), text_color=tf4_rsi > rsiOverbought ? green : tf4_rsi < rsiOversold ? red : dim, text_size=size.tiny, bgcolor=panelBg)

    // TF5
    table.cell(tbl, 0, 5, tfLabel(tf5), text_color=white, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 5, stateLabel(tf5_state), text_color=stateClr(tf5_state), text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 5, str.tostring(math.round(tf5_rsi)), text_color=tf5_rsi > rsiOverbought ? green : tf5_rsi < rsiOversold ? red : dim, text_size=size.tiny, bgcolor=panelBg)

    // Separator
    table.cell(tbl, 0, 6, "", bgcolor=headerBg)
    table.cell(tbl, 1, 6, "", bgcolor=headerBg)
    table.cell(tbl, 2, 6, "", bgcolor=headerBg)

    // Alignment
    alignClr = isBullAligned ? green : isBearAligned ? red : isConflicted ? amber : cyan
    table.cell(tbl, 0, 7, "ALIGNMENT", text_color=dim, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 7, alignLabel, text_color=alignClr, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 7, str.tostring(alignScore) + "/5", text_color=alignClr, text_size=size.tiny, bgcolor=panelBg)

    // Live price
    chgPct = close[1] != 0 ? (close - close[1]) / close[1] * 100 : 0
    priceClr = chgPct > 0 ? green : chgPct < 0 ? red : white
    table.cell(tbl, 0, 8, syminfo.ticker, text_color=white, text_size=size.tiny, bgcolor=headerBg)
    table.cell(tbl, 1, 8, str.tostring(close, format.mintick), text_color=priceClr, text_size=size.tiny, bgcolor=headerBg)
    table.cell(tbl, 2, 8, (chgPct > 0 ? "+" : "") + str.tostring(math.round(chgPct * 100) / 100) + "%", text_color=priceClr, text_size=size.tiny, bgcolor=headerBg)

    // Source / freshness footer (data integrity)
    srcText = "chart " + timeframe.period + (useConfirmedHTF ? " • HTF confirmed" : " • HTF live") + (anyTfMissing ? " • WARMUP" : "")
    srcClr = anyTfMissing ? amber : dim
    table.cell(tbl, 0, 9, "SRC", text_color=dim, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 1, 9, srcText, text_color=srcClr, text_size=size.tiny, bgcolor=panelBg)
    table.cell(tbl, 2, 9, "", bgcolor=panelBg)

// ═══════════════════════════════════════════════════════════════
// LIVE PRICE LABEL (optional — top of chart)
// ═══════════════════════════════════════════════════════════════

var label lbl = na
if showPriceLbl and barstate.islast
    priceStr = str.tostring(close, format.mintick)
    chg = close[1] != 0 ? (close - close[1]) / close[1] * 100 : 0.0
    chgStr = (chg > 0 ? "+" : "") + str.tostring(math.round(chg * 100) / 100) + "%"
    lblClr = chg > 0 ? color.new(#10B981, 10) : chg < 0 ? color.new(#EF4444, 10) : color.new(#64748B, 10)

    if na(lbl)
        lbl := label.new(bar_index + 3, high, priceStr + "  " + chgStr, color=lblClr, textcolor=color.white, size=size.normal, style=label.style_label_left)
    else
        label.set_xy(lbl, bar_index + 3, high)
        label.set_text(lbl, priceStr + "  " + chgStr)
        label.set_color(lbl, lblClr)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════

alertcondition(alignScore >= alignBullThresh and alignScore[1] < alignBullThresh, "Bull Alignment", "MSP State: 3+ timeframes now TRENDING UP — bull alignment")
alertcondition(alignScore <= -alignBearThresh and alignScore[1] > -alignBearThresh, "Bear Alignment", "MSP State: 3+ timeframes now TRENDING DOWN — bear alignment")
alertcondition(math.abs(alignScore) <= alignConflictRange and math.abs(alignScore[1]) > alignConflictRange, "Alignment Lost", "MSP State: Timeframe alignment lost — conflicting signals")
