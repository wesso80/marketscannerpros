// This Pine Script source code is subject to the terms of the Mozilla Public License 2.0
// Copyright MarketScanner Pros - Dynamic Volatility Engine (DVE) v2+
// Full 5-layer implementation: BBWP, VHM, Vol Regime, Squeeze, Phase Persistence,
// Signal Triggering, Breakout Readiness, Exhaustion Risk, Trap Detection
// Display Modes: Clean / Pro / Diagnostic - Verdict-first table

//@version=6
indicator("MSP - Dynamic Volatility Engine", shorttitle="MSP DVE", overlay=false, max_labels_count=500)

// INPUTS
grp_bbwp = "BBWP Settings"
bbLen = input.int(13, "BB Length", minval=5, maxval=50, group=grp_bbwp)
lookback = input.int(252, "Percentile Lookback", minval=50, maxval=500, group=grp_bbwp)
smaPeriod = input.int(5, "BBWP SMA Period", minval=2, maxval=20, group=grp_bbwp)
stdMult = input.float(2.0, "BB Std Multiplier", minval=0.5, maxval=4.0, step=0.5, group=grp_bbwp)

grp_thresh = "Regime Thresholds"
compThresh = input.float(15.0, "Compression (<)", minval=1, maxval=40, group=grp_thresh)
expThresh = input.float(70.0, "Expansion (>)", minval=50, maxval=95, group=grp_thresh)
climThresh = input.float(90.0, "Climax (>=)", minval=75, maxval=99, group=grp_thresh)

grp_dir = "Directional Bias"
biasThresh = input.float(15.0, "Bias Threshold (+/-)", minval=5, maxval=40, group=grp_dir)
adxLen = input.int(14, "ADX Length", minval=7, maxval=30, group=grp_dir)
stochKLen = input.int(14, "Stochastic %K", minval=5, maxval=21, group=grp_dir)
stochKSm = input.int(3, "Stochastic Smooth", minval=1, maxval=5, group=grp_dir)
stochDSm = input.int(3, "Signal %D", minval=1, maxval=5, group=grp_dir)

grp_kc = "Keltner / Squeeze"
kcLen = input.int(20, "Keltner Length", minval=10, maxval=50, group=grp_kc)
kcMult = input.float(1.5, "Keltner Multiplier", minval=0.5, maxval=3.0, step=0.5, group=grp_kc)

grp_vis = "Visual Settings"
uiMode = input.string("Pro", "Display Mode", options=["Clean", "Pro", "Diagnostic"], group=grp_vis)
showTable = input.bool(true, "Show Verdict Table", group=grp_vis)
showPressure = input.bool(true, "Show Pressure Ribbon", group=grp_vis)
showVHM = input.bool(true, "Show VHM Histogram", group=grp_vis)
showBg = input.bool(true, "Show Regime Background", group=grp_vis)
showExhaust = input.bool(true, "Show Exhaustion Warnings", group=grp_vis)
showMinorMarks = input.bool(false, "Show Minor Diagnostic Markers", group=grp_vis)
showLastBarLbl = input.bool(false, "Show Last-Bar Summary Label", group=grp_vis)
bgTransparency = input.int(95, "Background Transparency", minval=85, maxval=100, group=grp_vis)

isCleanMode = uiMode == "Clean"
isProMode = uiMode == "Pro"
isDiagMode = uiMode == "Diagnostic"

// LAYER 1: BBWP
basis = ta.sma(close, bbLen)
dev = ta.stdev(close, bbLen) * stdMult
bbUpper = basis + dev
bbLower = basis - dev
bbWidth = basis != 0 ? (bbUpper - bbLower) / basis : 0.0

countBelow(src, length) =>
    cnt = 0
    cur = src
    for i = 1 to length
        cnt += src[i] <= cur ? 1 : 0
    cnt

rawPctRank = lookback > 0 ? countBelow(bbWidth, lookback) / lookback * 100 : 50.0
enoughHistory = bar_index >= lookback
bbwp = enoughHistory ? math.max(0.0, math.min(100.0, rawPctRank)) : 50.0
bbwpSma = ta.sma(bbwp, smaPeriod)

vhmRoc = bbwp - nz(bbwp[1])
vhmSmoothed = ta.sma(vhmRoc, smaPeriod)
vhmAccel = vhmSmoothed - nz(vhmSmoothed[1])
vhmDirection = vhmAccel > 0.01 ? 1 : vhmAccel < -0.01 ? -1 : 0

volRegime = bbwp >= climThresh ? 4 : bbwp > expThresh ? 3 : bbwp < compThresh and vhmDirection == 1 ? 5 : bbwp < compThresh ? 1 : 2

regimeConfidence = volRegime == 1 ? (compThresh - bbwp) / compThresh * 100 :
     volRegime == 4 ? math.max(50.0, (bbwp - climThresh) / (100 - climThresh) * 100) :
     volRegime == 3 ? (bbwp - expThresh) / (climThresh - expThresh) * 100 :
     volRegime == 5 ? 50.0 :
     math.min((bbwp - compThresh), (expThresh - bbwp)) / ((expThresh - compThresh) / 2) * 100
regimeConf = math.max(0.0, math.min(100.0, regimeConfidence))

// LAYER 1b: Squeeze
kcBasis = ta.sma(close, kcLen)
kcRange = ta.atr(kcLen) * kcMult
kcUpper = kcBasis + kcRange
kcLower = kcBasis - kcRange
isSqueeze = bbLower > kcLower and bbUpper < kcUpper
squeezeFiring = isSqueeze[1] and not isSqueeze

// LAYER 2: Directional Bias
stK = ta.stoch(close, high, low, stochKLen)
stKSmooth = ta.sma(stK, stochKSm)
stDSmooth = ta.sma(stKSmooth, stochDSm)
stSpread = stKSmooth - stDSmooth
stKSlope = stKSmooth - nz(stKSmooth[1])
stDSlope = stDSmooth - nz(stDSmooth[1])

stochScore = 0.0
stochScore += stSpread > 0 ? 4.0 : stSpread < 0 ? -4.0 : 0.0
stochScore += stKSlope > 0 ? 3.0 : stKSlope < 0 ? -3.0 : 0.0
stochScore += stDSlope > 0 ? 3.0 : stDSlope < 0 ? -3.0 : 0.0
stochScore += stKSmooth > 50 and stSpread > 0 ? 5.0 : stKSmooth < 50 and stSpread < 0 ? -5.0 : 0.0
stochScore := math.max(-15.0, math.min(15.0, stochScore))

sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

trendScore = 0.0
trendScore += close > sma20 ? 5.0 : close < sma20 ? -5.0 : 0.0
trendScore += close > sma50 ? 5.0 : close < sma50 ? -5.0 : 0.0
trendScore += sma20 > sma50 ? 5.0 : sma20 < sma50 ? -5.0 : 0.0
trendScore += adxVal >= 25 ? (diPlus > diMinus ? 5.0 : -5.0) : 0.0
trendScore := math.max(-20.0, math.min(20.0, trendScore))

volSma20 = ta.sma(volume, 20)
hasVolume = nz(volSma20) > 0
volRatio = hasVolume ? volume / volSma20 : 1.0
volExpScore = math.min(10.0, math.max(0.0, (volRatio - 0.5) / 1.5 * 10.0))
changePct = nz(close[1]) != 0 ? (close - nz(close[1])) / nz(close[1]) * 100 : 0.0
volDirScore = hasVolume ? (changePct > 0 ? volExpScore : changePct < 0 ? -volExpScore : 0.0) : 0.0

dirScore = stochScore + trendScore + volDirScore
dirScore := math.max(-100.0, math.min(100.0, dirScore))
isBullBias = dirScore > biasThresh
isBearBias = dirScore < -biasThresh

// LAYER 3: Phase Persistence
var int compBars = 0
compBars := bbwp < compThresh ? compBars + 1 : 0

var int totalCompEps = 0
var int totalCompBars = 0
var bool wasInComp = false
if bbwp < compThresh
    wasInComp := true
else if wasInComp
    totalCompEps += 1
    totalCompBars += compBars[1]
    wasInComp := false

avgCompLen = totalCompEps > 0 ? totalCompBars / totalCompEps : 20

// LAYER 4: Signal Triggering
wasCompressed = bbwp[1] <= compThresh or bbwp[2] <= compThresh or bbwp[3] <= compThresh
crossedAbove = bbwp > compThresh
bbwpConfirm = bbwp > bbwpSma or vhmDirection == 1
stochBull = stKSmooth > stDSmooth and stKSlope > 0
stochBear = stKSmooth < stDSmooth and stKSlope < 0

sigCompUp = enoughHistory and wasCompressed and crossedAbove and bbwpConfirm and stochBull and isBullBias
sigCompDown = enoughHistory and wasCompressed and crossedAbove and bbwpConfirm and stochBear and isBearBias
sigExpUp = enoughHistory and bbwp >= climThresh and bbwpSma >= climThresh and stochBull and isBullBias
sigExpDown = enoughHistory and bbwp >= climThresh and bbwpSma >= climThresh and stochBear and isBearBias

isArmed = bbwp < compThresh and bbwp > (compThresh - 3)

// Use distance from the relevant threshold per signal family
isExpSig = sigExpUp or sigExpDown
bbwpDist = isExpSig ? math.abs(bbwp - climThresh) : math.abs(bbwp - compThresh)
strengthBBWP = bbwpDist > 5 ? 30.0 : bbwpDist > 3 ? 20.0 : bbwpDist > 0 ? 10.0 : 0.0
strengthSMA = (sigCompUp or sigCompDown) and bbwpSma > compThresh ? 20.0 : isExpSig and bbwpSma >= climThresh ? 20.0 : vhmDirection == 1 ? 10.0 : 0.0
absStoch = math.abs(stSpread)
strengthStoch = absStoch >= 15 ? 25.0 : absStoch >= 10 ? 17.0 : absStoch >= 5 ? 8.0 : 0.0
strengthDir = math.abs(dirScore) / 100.0 * 25.0

signalStrength = sigCompUp or sigCompDown or sigExpUp or sigExpDown ? math.min(100.0, strengthBBWP + strengthSMA + strengthStoch + strengthDir) : 0.0

// SUPPORTING ENGINES
// Weighted breakout readiness model
// Compression depth: 30%, persistence: 20%, VHM acceleration: 20%, squeeze: 15%, directional pressure: 15%
depthRaw = compThresh > 0 ? (compThresh - bbwp) / compThresh * 100.0 : 0.0
compDepthScore = bbwp < compThresh ? math.max(0.0, math.min(100.0, depthRaw)) : 0.0

persistRaw = avgCompLen > 0 ? compBars / avgCompLen * 100.0 : 0.0
compPersistScore = math.max(0.0, math.min(100.0, persistRaw))

vhmAccelRaw = vhmDirection == 1 ? math.max(0.0, vhmAccel) * 400.0 : 0.0
vhmAccelScore = math.max(0.0, math.min(100.0, vhmAccelRaw))

squeezeScore = isSqueeze ? 100.0 : squeezeFiring ? 70.0 : 0.0
dirPressureScore = math.max(0.0, math.min(100.0, math.abs(dirScore)))

breakoutReadiness =
     compDepthScore * 0.30 +
     compPersistScore * 0.20 +
     vhmAccelScore * 0.20 +
     squeezeScore * 0.15 +
     dirPressureScore * 0.15
breakoutReadiness := math.max(0.0, math.min(100.0, breakoutReadiness))
brLabel = breakoutReadiness >= 80 ? "EXTREME" : breakoutReadiness >= 60 ? "HIGH" : breakoutReadiness >= 40 ? "MODERATE" : "LOW"

exhScore = 0.0
exhScore += bbwp > 85 ? 30.0 : 0.0
exhScore += bbwp > 95 ? 20.0 : 0.0
exhScore += stKSmooth > 80 or stKSmooth < 20 ? 20.0 : 0.0
exhScore += adxVal > 35 and vhmDirection == -1 ? 15.0 : 0.0
exhScore += vhmDirection == -1 and vhmRoc < -0.5 ? 15.0 : 0.0
exhScore := math.min(100.0, exhScore)
exhLabel = exhScore >= 80 ? "EXTREME" : exhScore >= 60 ? "HIGH" : exhScore >= 40 ? "MODERATE" : "LOW"

trapCandidate = bbwp < compThresh and isSqueeze and math.abs(dirScore) < biasThresh
fakeoutRisk = squeezeFiring and (math.abs(dirScore) < biasThresh or signalStrength < 55)
confirmedRelease = (sigCompUp or sigCompDown) and signalStrength >= 70 and breakoutReadiness >= 60 and not fakeoutRisk
exhaustionTrap = exhScore >= 70 and (volRegime == 4 or sigExpUp or sigExpDown)

trapState = exhaustionTrap ? "EXHAUSTION TRAP" : confirmedRelease ? "CONFIRMED RELEASE" : fakeoutRisk ? "FAKEOUT RISK" : trapCandidate ? "TRAP CANDIDATE" : "NONE"
trapRisk = trapCandidate or fakeoutRisk or exhaustionTrap

// FLAGS
flagSignalUp = sigCompUp or sigExpUp
flagSignalDown = sigCompDown or sigExpDown

phaseStatus = volRegime == 1 ? (compBars < avgCompLen / 2 ? "EARLY" : compBars < avgCompLen ? "MID" : compBars < avgCompLen * 1.25 ? "LATE" : "STRETCHED") : volRegime == 4 ? "EXTREME" : volRegime == 3 ? "ACTIVE" : volRegime == 5 ? "TRANSITION" : "-"

setupGrade = signalStrength >= 85 and breakoutReadiness >= 75 and exhScore < 40 ? "A+" :
     signalStrength >= 75 and breakoutReadiness >= 65 and exhScore < 50 ? "A" :
     signalStrength >= 65 and breakoutReadiness >= 55 ? "B" :
     signalStrength >= 55 ? "C" : "D"

alignedBullish = flagSignalUp and signalStrength >= 70 and breakoutReadiness >= 60 and exhScore < 60 and not trapRisk
alignedBearish = flagSignalDown and signalStrength >= 70 and breakoutReadiness >= 60 and exhScore < 60 and not trapRisk
formingSetup = (isArmed or breakoutReadiness >= 55) and not alignedBullish and not alignedBearish and not trapRisk
riskHigh = trapRisk or exhScore >= 80

action = riskHigh ? "AVOID" : (alignedBullish or alignedBearish) ? "GO" : formingSetup ? "WATCH" : "WAIT"
actionColor = action == "GO" ? color.new(#10B981, 0) : action == "WATCH" ? color.new(color.yellow, 0) : action == "AVOID" ? color.new(color.red, 0) : color.new(color.gray, 0)

// SIGNAL TIERS
tier1Up = alignedBullish
tier1Down = alignedBearish
tier2Up = formingSetup and isBullBias
tier2Down = formingSetup and isBearBias
tier3Diag = isDiagMode and (trapCandidate or fakeoutRisk or squeezeFiring)
tierArmed = isArmed and breakoutReadiness >= 50 and not riskHigh

// PRESSURE RIBBON
pressureLevel = dirScore >= 30 ? 6.0 : dirScore >= biasThresh ? 5.0 : dirScore > 5 ? 4.0 : dirScore < -30 ? 1.0 : dirScore < -biasThresh ? 2.0 : dirScore < -5 ? 3.0 : 3.5
pressureColor = dirScore >= 30 ? color.new(#10B981, 0) : dirScore >= biasThresh ? color.new(#10B981, 35) : dirScore > 5 ? color.new(#10B981, 70) : dirScore <= -30 ? color.new(color.red, 0) : dirScore <= -biasThresh ? color.new(color.red, 35) : dirScore < -5 ? color.new(color.red, 70) : color.new(color.gray, 70)

// PLOTS
bgCol = showBg and not isCleanMode ? (volRegime == 1 ? color.new(color.blue, bgTransparency) : volRegime == 5 ? color.new(color.yellow, math.min(bgTransparency + 1, 100)) : volRegime == 3 ? color.new(color.orange, bgTransparency) : volRegime == 4 ? color.new(color.red, math.max(bgTransparency - 2, 85)) : na) : na
bgcolor(bgCol, title="Regime BG")

hline(compThresh, "Compression", color=color.new(color.blue, 60), linestyle=hline.style_dashed)
hline(expThresh, "Expansion", color=color.new(color.orange, 60), linestyle=hline.style_dashed)
hline(climThresh, "Climax", color=color.new(color.red, 60), linestyle=hline.style_dashed)

plot(not isCleanMode ? bbwpSma : na, "BBWP SMA", color=color.new(color.white, 40), linewidth=1)
bbwpColor = volRegime == 1 ? color.new(color.blue, 0) : volRegime == 5 ? color.new(color.yellow, 0) : volRegime == 3 ? color.new(color.orange, 0) : volRegime == 4 ? color.new(color.red, 0) : color.new(color.gray, 30)
plot(bbwp, "BBWP", color=bbwpColor, linewidth=2)

vhmCol = vhmSmoothed > 0 ? (vhmDirection == 1 ? color.new(#10B981, 0) : color.new(#10B981, 60)) : (vhmDirection == -1 ? color.new(color.red, 0) : color.new(color.red, 60))
plot(showVHM and not isCleanMode ? vhmSmoothed * 2.5 : na, "VHM", style=plot.style_columns, color=vhmCol)
plot(showPressure and not isCleanMode ? pressureLevel : na, "Pressure Ribbon", color=pressureColor, linewidth=2)

plotshape(isDiagMode and isSqueeze, "Squeeze", shape.diamond, location.bottom, color.new(color.fuchsia, 60), size=size.tiny)
plotshape(isDiagMode and squeezeFiring, "Squeeze Fire", shape.triangleup, location.bottom, color.new(color.lime, 0), size=size.normal, text="SQZ")

plotshape((isProMode or isDiagMode) and tier1Up, "Tier1 Up", shape.triangleup, location.top, color.new(#10B981, 0), size=size.large, text="GO UP")
plotshape((isProMode or isDiagMode) and tier1Down, "Tier1 Down", shape.triangledown, location.top, color.new(color.red, 0), size=size.large, text="GO DN")
plotshape((isProMode or isDiagMode) and tier2Up, "Tier2 Up", shape.triangleup, location.top, color.new(#10B981, 45), size=size.small, text="FORM")
plotshape((isProMode or isDiagMode) and tier2Down, "Tier2 Down", shape.triangledown, location.top, color.new(color.red, 45), size=size.small, text="FORM")
plotshape(tier3Diag, "Tier3 Diag", shape.circle, location.bottom, color.new(color.gray, 10), size=size.tiny)
plotshape((isDiagMode or showMinorMarks) and not isCleanMode and tierArmed, "Armed", shape.circle, location.bottom, color.new(color.yellow, 15), size=size.tiny)

plotshape(showExhaust and not isCleanMode and exhScore >= 60, "Exhaustion", shape.xcross, location.top, color=color.new(color.red, 20), size=size.tiny)

// TABLE
var table dash = table.new(position.top_right, 2, 13, bgcolor=color.new(#0F172A, 8), frame_width=1, frame_color=color.new(color.gray, 70))
var label lastBarLbl = na

regimeStr = volRegime == 1 ? "COMPRESSION" : volRegime == 2 ? "NEUTRAL" : volRegime == 3 ? "EXPANSION" : volRegime == 4 ? "CLIMAX" : "TRANSITION"
biasStr = isBullBias ? "BULLISH" : isBearBias ? "BEARISH" : "NEUTRAL"
sigTableText = alignedBullish ? "ALIGNED BULLISH" : alignedBearish ? "ALIGNED BEARISH" : formingSetup ? "FORMING" : "NEUTRAL"

gradeColor = setupGrade == "A+" ? color.new(#10B981, 0) : setupGrade == "A" ? color.lime : setupGrade == "B" ? color.yellow : color.gray
regCol = volRegime == 1 ? color.aqua : volRegime == 4 ? color.red : volRegime == 3 ? color.orange : color.white
phCol = phaseStatus == "STRETCHED" ? color.red : phaseStatus == "LATE" ? color.yellow : color.white
biasCol = isBullBias ? color.lime : isBearBias ? color.red : color.gray
sigCol = alignedBullish ? color.lime : alignedBearish ? color.red : formingSetup ? color.yellow : color.gray
strCol = signalStrength >= 70 ? color.lime : signalStrength >= 55 ? color.yellow : color.white
brCol = breakoutReadiness >= 60 ? color.yellow : color.white
exCol = exhScore >= 60 ? color.red : color.white
trapStr = trapState
sqzStr = isSqueeze ? "ON" : "-"
stCol = riskHigh ? color.red : trapState == "CONFIRMED RELEASE" ? color.lime : isSqueeze ? color.fuchsia : color.gray

if barstate.islast and showTable
    table.cell(dash, 0, 0, "ACTION", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, action, text_color=actionColor, text_size=size.small)

    table.cell(dash, 0, 1, "SETUP", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, setupGrade, text_color=gradeColor, text_size=size.small)

    table.cell(dash, 0, 2, "REGIME", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, regimeStr, text_color=regCol, text_size=size.small)

    table.cell(dash, 0, 3, "PHASE", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, phaseStatus, text_color=phCol, text_size=size.small)

    table.cell(dash, 0, 4, "BBWP", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(bbwp, "#.0"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 5, "CONF %", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(regimeConf, "#.0"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 6, "BIAS", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, biasStr + " (" + str.tostring(dirScore, "#.0") + ")", text_color=biasCol, text_size=size.small)

    table.cell(dash, 0, 7, "SIGNAL", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, sigTableText, text_color=sigCol, text_size=size.small)

    table.cell(dash, 0, 8, "STRENGTH", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(signalStrength, "#.0"), text_color=strCol, text_size=size.small)

    table.cell(dash, 0, 9, "BRK READY", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, brLabel + " (" + str.tostring(breakoutReadiness, "#.0") + ")", text_color=brCol, text_size=size.small)

    table.cell(dash, 0, 10, "EXHAUST", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 10, exhLabel + " (" + str.tostring(exhScore, "#.0") + ")", text_color=exCol, text_size=size.small)

    table.cell(dash, 0, 11, "SQZ/TRAP", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, sqzStr + " / " + trapStr, text_color=stCol, text_size=size.small)

    // Source / freshness footer (data integrity)
    srcText = "chart " + timeframe.period + (hasVolume ? " • vol OK" : " • NO VOL") + (enoughHistory ? "" : " • WARMUP")
    srcClr = (hasVolume and enoughHistory) ? color.gray : color.yellow
    table.cell(dash, 0, 12, "SRC", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 12, srcText, text_color=srcClr, text_size=size.small)

if showLastBarLbl and barstate.islast
    lblText = action + " | " + regimeStr + " | " + biasStr + " | " + phaseStatus
    if na(lastBarLbl)
        lastBarLbl := label.new(bar_index, bbwp, lblText, style=label.style_label_left, textcolor=color.white, color=color.new(#111827, 10), size=size.small)
    else
        label.set_xy(lastBarLbl, bar_index, bbwp)
        label.set_text(lastBarLbl, lblText)
        label.set_color(lastBarLbl, color.new(#111827, 10))
        label.set_textcolor(lastBarLbl, color.white)

// ALERTS - transition-gated to avoid repeated firing each bar
var string prevAction = "WAIT"
actionChanged = action != prevAction
enteredGo = actionChanged and action == "GO"
enteredAvoid = actionChanged and action == "AVOID"
enteredWatch = actionChanged and action == "WATCH"
if barstate.isconfirmed
    prevAction := action

alertcondition(enteredGo and alignedBullish, "DVE GO Bullish", "DVE: Verdict GO - aligned bullish release")
alertcondition(enteredGo and alignedBearish, "DVE GO Bearish", "DVE: Verdict GO - aligned bearish release")
alertcondition(enteredWatch, "DVE WATCH", "DVE: Verdict WATCH - setup forming")
alertcondition(enteredAvoid, "DVE AVOID", "DVE: Verdict AVOID - trap or exhaustion risk")
alertcondition(alignedBullish, "DVE Aligned Bullish (raw)", "DVE: High-quality bullish release aligned")
alertcondition(alignedBearish, "DVE Aligned Bearish (raw)", "DVE: High-quality bearish release aligned")
alertcondition(squeezeFiring and not trapRisk, "Squeeze Fired", "DVE: Squeeze fired (clean)")
alertcondition(trapRisk, "Trap Risk", "DVE: Trap risk detected")
alertcondition(exhScore >= 60, "Exhaustion Risk", "DVE: Exhaustion risk elevated")
alertcondition(bbwp >= climThresh, "Volatility Climax", "DVE: Volatility in climax regime")
